# ============================================================
# Artesana del Barro - .htaccess v20260915a
# Cache-Control, Seguridad HTTP Headers, Compresion GZIP
# ============================================================

# --- HTTPS redirect (si el servidor lo maneja) ---
# Si usas Cloudflare, esto puede quedar como referencia
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Compresion GZIP ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# --- CACHE: Assets versionados (CSS, JS, Imagenes, Fuentes) ---
# Estos archivos tienen versioning en la URL (?v=...) o hash en el nombre
# Se pueden cachear 1 anio de forma segura
<IfModule mod_expires.c>
  ExpiresActive On

  # Default: sin cache para HTML
  ExpiresDefault                        A0
  ExpiresByType text/html               A0

  # Assets: 1 anio
  ExpiresByType text/css                A31536000
  ExpiresByType application/javascript  A31536000
  ExpiresByType image/webp              A31536000
  ExpiresByType image/jpeg              A31536000
  ExpiresByType image/png               A31536000
  ExpiresByType image/gif               A31536000
  ExpiresByType image/svg+xml           A31536000
  ExpiresByType image/x-icon            A31536000
  ExpiresByType video/mp4               A31536000
  ExpiresByType font/woff2              A31536000
  ExpiresByType font/woff               A31536000
  ExpiresByType application/font-woff2  A31536000
</IfModule>

<IfModule mod_headers.c>
  # Cache: assets inmutables (CSS/JS versionados)
  <FilesMatch "\.(css|js|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache: imagenes y video
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|ico|mp4|svg)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Sin cache para HTML (siempre fresco)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # =====================================================
  # SEGURIDAD HTTP HEADERS
  # =====================================================

  # HSTS (HTTP Strict Transport Security)
  # max-age=31536000 (1 anio). Activar includeSubDomains solo cuando
  # todos los subdominios esten en HTTPS. preload: solo cuando estes listo.
  Header always set Strict-Transport-Security 'max-age=31536000; includeSubDomains'

  # Proteccion contra clickjacking
  Header always set X-Frame-Options 'SAMEORIGIN'

  # Evitar MIME sniffing
  Header always set X-Content-Type-Options 'nosniff'

  # Cross-Origin Opener Policy
  # 'same-origin-allow-popups' para permitir target=_blank a WhatsApp, IG, etc.
  Header always set Cross-Origin-Opener-Policy 'same-origin-allow-popups'

  # Referrer Policy
  Header always set Referrer-Policy 'strict-origin-when-cross-origin'

  # Link headers: se gestionan en Cloudflare (Transform Rules), no aquí

  # Permissions Policy (deshabilitar features no usadas)
  Header always set Permissions-Policy 'camera=(), microphone=(), geolocation=(self), payment=()'
</IfModule>

# --- 301: /index.html -> / (evita contenido duplicado) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://artesanadelbarro.com.ar/ [R=301,L]
</IfModule>
